APP_NAME="Dairy Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development database (MySQL 8.4). See docs/DECISIONS.md D2.
# SQLite is not supported by this application.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dairy_management
DB_USERNAME=
DB_PASSWORD=

# Automated tests run against this schema exclusively. It is wiped by
# RefreshDatabase on every run, so it must never point at dev or production.
DB_TEST_DATABASE=dairy_management_test

# Foundation seed data, created by `php artisan db:seed`.
BUSINESS_NAME="Dairy Farm"
FARM_NAME="Main Farm"
FARM_CODE=MAIN

# Development administrator.
#
# The seeder creates this account only when BOTH ADMIN_EMAIL and ADMIN_PASSWORD
# are set; otherwise it skips and says so. Never commit a real password here.
# The safer route is to leave these blank and run:
#
#   php artisan dairy:create-admin
#
# which prompts for the password without echoing it and without putting it in
# your shell history.
ADMIN_NAME="Farm Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dairy.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
